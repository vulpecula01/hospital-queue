# .env.example
# ==========================================================
# คัดลอกไฟล์นี้เป็นชื่อ ".env" (วางไว้คู่กับ main.py ในโฟลเดอร์เดียวกัน)
# แล้วแก้ค่าด้านล่างให้ตรงกับของจริงก่อนใช้งาน
#
# ⚠️ ห้าม commit/แชร์ไฟล์ .env จริงให้คนอื่น เพราะมีรหัสผ่าน/secret key อยู่ในนั้น
# ==========================================================

# ฐานข้อมูล MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=@Nurak@1234
DB_NAME=hospital_queue_db

# IP วง LAN ของเครื่อง Server นี้ (ใช้แสดงในหน้าต่างๆ)
SERVER_IP=10.121.111.233

# 🔑 กุญแจลับสำหรับเข้ารหัสรหัสผ่านผู้ใช้งาน (ใช้กับระบบ Login)
# ต้องเป็นข้อความสุ่มที่ยาวและไม่มีใครเดาได้ — ห้ามใช้ค่าตัวอย่างด้านล่างจริง!
# สร้างค่าใหม่ของตัวเองด้วยคำสั่งนี้ (รันใน Python):
#   python -c "import secrets; print(secrets.token_hex(32))"
# แล้วเอาผลลัพธ์มาแทนที่ค่าด้านล่าง
SECRET_KEY=เปลี่ยนเป็นค่าที่สุ่มได้จากคำสั่งด้านบน_ห้ามใช้ค่านี้จริง
